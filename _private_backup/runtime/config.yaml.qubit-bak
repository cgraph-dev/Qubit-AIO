model:
  default: deepseek-v4-flash
  provider: opencode-go
  api_mode: chat_completions
  base_url: https://opencode.ai/zen/go/v1
toolsets:
- hermes-cli
- kanban
vad:
  enabled: false
logging:
  level: DEBUG
context:
  engine: compressor
mcp_servers:
  cgraph-graft:
    command: graft
    args:
    - mcp
    - /home/trick/Projects/Repos/CGraph Umbrella
    enabled: true
  voicebridge-graft:
    command: graft
    args:
    - mcp
    - /home/trick/Projects/Repos/openclaw-voice-bridge
    enabled: true
