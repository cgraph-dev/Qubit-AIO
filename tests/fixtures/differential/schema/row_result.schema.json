{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qubit.local/schemas/differential/row_result.schema.json",
  "title": "Differential row result (INTERFACE v1.2)",
  "description": "One result object per inventory row returned by run_inventory. Mirrors the v1.1 Row-result schema in /tmp/qubit-differential/INTERFACE.md plus the Plan section 8/15 evidence fields and the v1.2 transport/reference additions. additionalProperties is intentionally open: results also carry runner bookkeeping such as qubit_payload, qubit_raw_result_hash and missing_evidence. The v1.2 keys are optional because the runner only emits them on rows whose adapter exposes that transport/reference evidence.",
  "type": "object",
  "required": [
    "capability_id",
    "declared_disposition",
    "disposition",
    "executed",
    "qubit_executed",
    "reference_executed",
    "fixture_present",
    "adapter_mock",
    "refused",
    "unsafe_normalizers",
    "visual_only",
    "voice_mismatch",
    "persistence_diff",
    "secret_in_artifact",
    "production_caller",
    "diagnostics",
    "operator_prerequisite",
    "upstream_result_hash",
    "qubit_result_hash",
    "fixture_hash",
    "unclassifiable",
    "voice_utterance",
    "dashboard_route",
    "dashboard_control",
    "request_schema",
    "broker_policy_decision",
    "runtime_provider",
    "store_state_assertion",
    "output_event_assertion",
    "error_codes",
    "retry_recovery_proof",
    "audit_receipt_proof",
    "security_resource_proof",
    "package_proof",
    "response_headers",
    "screenshot_ref",
    "dom_snapshot_ref",
    "a11y_snapshot_ref",
    "raw_hash"
  ],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "declared_disposition": {"$ref": "#/$defs/disposition"},
    "disposition": {"$ref": "#/$defs/disposition"},
    "executed": {"type": "boolean"},
    "qubit_executed": {"type": "boolean"},
    "reference_executed": {"type": "boolean"},
    "fixture_present": {"type": "boolean"},
    "adapter_mock": {"type": "boolean"},
    "refused": {"type": "boolean"},
    "unsafe_normalizers": {"type": "array", "items": {"type": "string"}},
    "visual_only": {"type": "boolean"},
    "voice_mismatch": {"type": "boolean"},
    "persistence_diff": {"type": "boolean"},
    "secret_in_artifact": {"type": "boolean"},
    "production_caller": {"type": ["string", "null"]},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "detail"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "operator_prerequisite": {"type": ["string", "null"]},
    "upstream_result_hash": {"$ref": "#/$defs/hashOrNull"},
    "qubit_result_hash": {"$ref": "#/$defs/hashOrNull"},
    "fixture_hash": {"$ref": "#/$defs/hashOrNull"},
    "unclassifiable": {"type": "boolean"},
    "voice_utterance": {"type": ["string", "object", "array", "null"]},
    "dashboard_route": {"type": ["string", "object", "array", "null"]},
    "dashboard_control": {"type": ["string", "object", "array", "null"]},
    "request_schema": {"type": ["string", "object", "array", "null"]},
    "broker_policy_decision": {"type": ["string", "object", "array", "null"]},
    "runtime_provider": {"type": ["string", "object", "array", "null"]},
    "store_state_assertion": {"type": ["string", "object", "array", "null"]},
    "output_event_assertion": {"type": ["string", "object", "array", "null"]},
    "error_codes": {"type": ["array", "null"], "items": {"type": "string"}},
    "retry_recovery_proof": {"type": ["string", "object", "array", "null"]},
    "audit_receipt_proof": {"type": ["string", "object", "array", "null"]},
    "security_resource_proof": {"type": ["string", "object", "array", "null"]},
    "package_proof": {"type": ["string", "object", "array", "null"]},
    "response_headers": {"type": ["object", "null"]},
    "screenshot_ref": {"type": ["string", "object", "null"]},
    "dom_snapshot_ref": {"type": ["string", "object", "null"]},
    "a11y_snapshot_ref": {"type": ["string", "object", "null"]},
    "raw_hash": {"$ref": "#/$defs/hashOrNull"},
    "transport": {"enum": ["cli", "http", "sse", "ws", "rpc", null]},
    "headers": {"type": ["object", "null"]},
    "events": {"type": ["array", "null"]},
    "persisted_state": {},
    "reference_commit": {"type": ["string", "null"]},
    "reference_version": {"type": ["string", "null"]},
    "reference_pinned": {"type": ["boolean", "null"]},
    "unpinned_references": {"type": ["array", "null"], "items": {"type": "string"}},
    "disposition_basis": {"type": ["string", "object", "array", "null"]}
  },
  "additionalProperties": true,
  "$defs": {
    "disposition": {
      "enum": ["PASS", "FAIL", "SAFE_EQUIVALENT", "OPERATOR_ONLY", "OPEN"]
    },
    "hashOrNull": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
