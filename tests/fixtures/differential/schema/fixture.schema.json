{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qubit.local/schemas/differential/fixture.schema.json",
  "title": "Differential Fixture (INTERFACE v1.2)",
  "description": "Fixture object consumed by scripts/differential_parity.py. Mirrors /tmp/qubit-differential/INTERFACE.md (v1.2). A fixture has EITHER a command block (CLI argv) or a request block; the unused one may be null. v1.2 adds transport, base_url_ref, auth, sequence, events_expected and persisted_state_schema (all optional).",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_id",
    "family",
    "normalizers",
    "expected",
    "qubit",
    "hermes",
    "openclaw",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$",
      "description": "Must equal the inventory capability_id (stable)."
    },
    "family": {
      "enum": [
        "cli", "api", "rpc", "ws", "sse", "provider", "session", "memory",
        "file", "project", "skill", "plugin", "mcp", "cron", "gateway",
        "messaging", "browser", "desktop", "board", "task", "media", "acp",
        "webhook", "auth", "approval", "recovery", "dashboard", "voice"
      ]
    },
    "command": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["argv"],
          "properties": {
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "stdin": {"type": ["string", "null"]},
            "env": {
              "type": "object",
              "additionalProperties": {"type": "string"},
              "description": "Env var NAMES mapped to $NAME / env:NAME references only. Never a secret value."
            },
            "cwd": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      ]
    },
    "request": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["method", "path"],
          "properties": {
            "kind": {"type": ["string", "null"]},
            "method": {"type": ["string", "null"]},
            "path": {"type": ["string", "null"]},
            "headers": {"type": "object"},
            "body": {},
            "event": {},
            "argv": {"type": "array", "items": {"type": "string"}},
            "env": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "additionalProperties": true
        }
      ]
    },
    "transport": {
      "enum": ["http", "sse", "ws", "rpc"],
      "description": "INTERFACE v1.2 transport kind for a request fixture."
    },
    "base_url_ref": {"$ref": "#/$defs/envRef"},
    "auth": {"$ref": "#/$defs/authSpec"},
    "sequence": {
      "type": "array",
      "description": "INTERFACE v1.2 multi-step handshake/reconnect steps.",
      "items": {"$ref": "#/$defs/stepSpec"}
    },
    "events_expected": {
      "type": "array",
      "description": "INTERFACE v1.2 expected event stream, in declared server order.",
      "items": {"$ref": "#/$defs/eventExpectation"}
    },
    "persisted_state_schema": {"type": ["object", "null"]},
    "normalizers": {"$ref": "#/$defs/normalizerList"},
    "expected": {"type": "object"},
    "qubit": {"$ref": "#/$defs/qubitMapping"},
    "hermes": {"$ref": "#/$defs/upstreamMapping"},
    "openclaw": {"$ref": "#/$defs/upstreamMapping"},
    "references": {
      "type": "object",
      "description": "Optional real tri-way upstream invocations. Each key is an upstream project (hermes|openclaw); each value is a reference spec run through that project's binary. Absent references mean the row is OPERATOR_ONLY, never PASS.",
      "additionalProperties": {"$ref": "#/$defs/referenceSpec"}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "$defs": {
    "envRef": {
      "type": "string",
      "pattern": "^(\\$[A-Za-z_][A-Za-z0-9_]*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}|env:[A-Za-z_][A-Za-z0-9_]*)$",
      "description": "Environment reference ($NAME, ${NAME} or env:NAME). Never the secret value."
    },
    "authSpec": {
      "type": "object",
      "required": ["header", "value_ref"],
      "properties": {
        "header": {"type": "string", "minLength": 1},
        "value_ref": {"$ref": "#/$defs/envRef"}
      },
      "additionalProperties": true
    },
    "stepSpec": {
      "type": "object",
      "description": "One step of a v1.2 sequence: a CLI/HTTP/SSE/WS/RPC step spec.",
      "properties": {
        "kind": {"enum": ["cli", "http", "sse", "ws", "rpc"]},
        "method": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "headers": {"type": "object"},
        "body": {},
        "event": {},
        "argv": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "messages": {"type": "array"},
        "params": {}
      },
      "additionalProperties": true
    },
    "eventExpectation": {
      "type": "object",
      "required": ["event", "order"],
      "properties": {
        "event": {"type": "string"},
        "id": {"type": ["string", "null"]},
        "data": {},
        "order": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "referenceSpec": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "stdin": {"type": ["string", "null"]},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Env var NAMES mapped to $NAME / env:NAME references only. Never a secret value."
        },
        "cwd": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "normalizerList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "timestamp", "uuid", "temp_path", "pid", "session_token",
          "generated_hash", "product_branding"
        ]
      }
    },
    "qubitMapping": {
      "type": "object",
      "required": ["path", "caller"],
      "properties": {
        "path": {"type": ["string", "null"], "description": "file:line, or null if unknown"},
        "caller": {"type": ["string", "null"], "description": "Production symbol; feeds missing_production_caller gate."},
        "approval": {"type": ["string", "null"]},
        "mapping_status": {"enum": ["VERIFIED", "UNVERIFIED", "N/A"]}
      },
      "additionalProperties": true
    },
    "upstreamMapping": {
      "type": "object",
      "properties": {
        "path": {"type": ["string", "null"], "description": "Upstream file:line, or null when unknown"},
        "symbol": {"type": ["string", "null"]},
        "mapping_status": {
          "enum": ["VERIFIED", "UNVERIFIED", "N/A"],
          "description": "UNVERIFIED means no pinned-clone file:line was confirmed; the runner must classify dependent rows OPEN."
        }
      },
      "additionalProperties": true
    }
  }
}
