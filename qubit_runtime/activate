#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Hermes dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `qubit` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-qubit-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `qubit pm
# install` and `qubit update` keep that check.
# ============================================================================
_QUBIT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_qubit_test_env="--test-environment"
_qubit_expect_extras=""
for _qubit_arg in "$@"; do
    if [ -n "$_qubit_expect_extras" ]; then
        _qubit_test_env="--test-environment=$_qubit_arg"
        _qubit_expect_extras=""
        continue
    fi
    case "$_qubit_arg" in
        --) break ;;
        --test-extras) _qubit_expect_extras=1 ;;
        --test-extras=*) _qubit_test_env="--test-environment=${_qubit_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_qubit_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _qubit_arg _qubit_test_env _qubit_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _qubit_arg _qubit_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_QUBIT_REPO/scripts/_activation.sh"

if ! qubit_sync "$_QUBIT_REPO" "$_qubit_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _qubit_test_env
    return 1 2>/dev/null || exit 1
fi
unset _qubit_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __HERMES_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_qubit_script="$(qubit_compose_env "$_QUBIT_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _qubit_script
    return 1 2>/dev/null || exit 1
}
_qubit_keys="$(printf '%s\n' "$_qubit_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __HERMES_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__QUBIT_SAVED_PATH="$PATH"
for _qubit_k in $_qubit_keys; do
    eval "__QUBIT_SAVED_$_qubit_k=\"\${$_qubit_k+set}\""
    eval "__QUBIT_PRIOR_$_qubit_k=\${$_qubit_k-__QUBIT_UNSET__}"
done
qubit_apply_env "$_qubit_script"

# This checkout, not whichever `qubit` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__QUBIT_WORKTREE="$_QUBIT_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__QUBIT_WORKTREE_NAME="$(git -C "$_QUBIT_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__QUBIT_WORKTREE_NAME" ] || [ "$__QUBIT_WORKTREE_NAME" = HEAD ]; then
    __QUBIT_WORKTREE_NAME="$(basename "$_QUBIT_REPO")"
fi
__QUBIT_SAVED_PS1="${PS1-__QUBIT_UNSET__}"
__QUBIT_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__QUBIT_UNSET__}"

_qubit_worktree_here() {
    _qubit_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_qubit_top" && pwd -P)" = "$(cd "$__QUBIT_WORKTREE" && pwd -P)" ]
}

qubit() {
    _qubit_worktree_here || {
        printf '%s\n' "qubit: $(pwd) is outside $__QUBIT_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__QUBIT_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" qubit "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe qubit "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python qubit "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe qubit "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python qubit "$@"
        else
            exec python qubit "$@"
        fi
    )
}

_qubit_prompt() {
    if [ "$__QUBIT_SAVED_PS1" = "__QUBIT_UNSET__" ]; then
        _qubit_base_ps1=""
    else
        _qubit_base_ps1="$__QUBIT_SAVED_PS1"
    fi
    if _qubit_worktree_here; then
        PS1="($__QUBIT_WORKTREE_NAME) $_qubit_base_ps1"
    else
        PS1="$_qubit_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_qubit_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_qubit_prompt
fi
_qubit_prompt

deactivate() {
    export PATH="$__QUBIT_SAVED_PATH"
    for _qubit_k in $__QUBIT_KEY_LIST; do
        eval "_qubit_was=\"\$__QUBIT_SAVED_$_qubit_k\""
        eval "_qubit_old=\"\$__QUBIT_PRIOR_$_qubit_k\""
        if [ "$_qubit_was" != "set" ]; then
            unset "$_qubit_k"
        else
            export "$_qubit_k=$_qubit_old"
        fi
        unset "__QUBIT_SAVED_$_qubit_k" "__QUBIT_PRIOR_$_qubit_k"
    done
    if [ "$__QUBIT_SAVED_PS1" = "__QUBIT_UNSET__" ]; then
        unset PS1
    else
        PS1="$__QUBIT_SAVED_PS1"
    fi
    if [ "$__QUBIT_SAVED_PROMPT_COMMAND" = "__QUBIT_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__QUBIT_SAVED_PROMPT_COMMAND"
    fi
    unset __QUBIT_SAVED_PATH __QUBIT_KEY_LIST __HERMES_ACTIVATED \
          __QUBIT_WORKTREE __QUBIT_WORKTREE_NAME \
          __QUBIT_SAVED_PS1 __QUBIT_SAVED_PROMPT_COMMAND
    unset -f deactivate qubit _qubit_worktree_here _qubit_prompt
    unset _qubit_k _qubit_was _qubit_old _qubit_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__QUBIT_KEY_LIST="$_qubit_keys"

# The composition library is not part of the user's shell.
unset -f qubit_sync qubit_bootstrap_python qubit_compose_env qubit_apply_env \
         qubit_activation_current qubit_ensure_env
unset _QUBIT_REPO _qubit_script _qubit_keys _qubit_k _qubit_top
