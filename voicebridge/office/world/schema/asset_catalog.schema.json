{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qubit.local/schema/office/asset_catalog.schema.json",
  "title": "Qubit Office asset catalog",
  "description": "Metadata for a LimeZu pack. Never art: file is a relative name in the local pack, not a shipped path.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id", "file", "theme", "category", "size", "footprint", "z",
      "layer", "surface", "orientations", "shadow_variant", "tags",
      "compatibility"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
      "file": { "type": "string", "minLength": 1 },
      "theme": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
      "category": { "type": "string", "minLength": 1 },
      "size": { "enum": [16, 32, 48] },
      "footprint": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "z": { "type": "integer" },
      "layer": {
        "enum": ["floor", "rug", "wall", "furniture", "decor", "lighting", "overlay", "portrait"]
      },
      "surface": {
        "enum": ["floor", "wall", "rug", "furniture", "decor", "lighting", "portrait", "ui"]
      },
      "orientations": {
        "type": "array",
        "minItems": 1,
        "items": { "enum": ["any", "north", "east", "south", "west"] }
      },
      "animation": { "type": ["string", "null"] },
      "shadow_variant": { "enum": ["shadowless", "black_shadow"] },
      "tags": { "type": "array", "items": { "type": "string" } },
      "compatibility": { "type": "array", "items": { "type": "string" } },
      "single_direction": { "type": "boolean" },
      "socket_bound": { "type": "boolean" }
    }
  }
}
