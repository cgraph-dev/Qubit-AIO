        "kinds": [
          "conversation"
        ],
        "max_reply_sentences": 3
      }
    },
    {
      "case_id": "acc-factconflict-001",
      "category": "personal_fact_conflict",
      "text": "remind me: my favorite demo color is teal now, not blue like I said before",
      "expected": {
        "correction_wins": true,
        "stale_value": "blue",
        "current_value": "teal"
      }
    },
    {
      "case_id": "acc-factconflict-002",
      "category": "personal_fact_conflict",
      "text": "what is my favorite demo color?",
      "expected": {
        "expect_current_fact": "teal",
        "must_not_answer_stale": "blue"
      }
    },
    {
      "case_id": "acc-factconflict-003",
      "category": "personal_fact_conflict",
      "text": "I moved the demo project folder, it lives in projects/demo-app-v2 now, not v1",
      "expected": {
        "correction_wins": true
      }
    },
    {
      "case_id": "acc-tool-001",
      "category": "tool_selection",
      "text": "set the volume to thirty percent",
      "expected": {
        "tool": null,
        "excluded_ambiguous": true,
        "note": "set-to-N% needs a level arg; whitelist has only up/down"
      }
    },
    {
      "case_id": "acc-tool-002",
      "category": "tool_selection",
      "text": "pause the music",
      "expected": {
        "tool": "local.youtube_pause",
        "args": {},
        "note": "replaces media-pause hint; whitelisted action exists"
      }
    },
    {
      "case_id": "acc-tool-003",
      "category": "tool_selection",
      "text": "open the text editor",
      "expected": {
        "tool": "local.open_app",
        "args": {
          "app": "text editor"
        }
      }
    },
    {
      "case_id": "acc-tool-004",
      "category": "tool_selection",
      "text": "take a screenshot of my screen",
      "expected": {
        "tool": "local.screenshot",
        "args": {}
      }
    },
    {
