[Unit]
Description=PersonaPlex full-duplex speech server (Vast.ai)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
Environment=HF_TOKEN=__HF_TOKEN__
ExecStart=/opt/personaplex/.venv/bin/python -m moshi.server --host __HOST__ --port 8998 --ssl /etc/personaplex/ssl
WorkingDirectory=/opt/personaplex
Restart=on-failure
RestartSec=5
# First model load is slow; give it room
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
