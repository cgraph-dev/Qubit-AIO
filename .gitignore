# browser automation persistent state (real logins — NEVER commit)
browser_profiles
browser_auto_state
*.done

# Playwright MCP probe output (transient page snapshots/console logs — never shipped)
.playwright-mcp/

# Playwright CLI session state (transient; regenerated per run).
.playwright-cli/

# Local screenshot/capture output for parity review (regenerable by re-running
# the capturing script; adds MBs of PNGs and must never bloat the vendored tree
# the upstream sync rebases over).
/output/

# opencode tooling: cache/deps are local, never committed (config/skills/commands are)
.opencode/node_modules/
opencode.json.backup

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# PII bake artifact: composed from live personal files by scripts/bake_brain.py.
# NEVER commit (plan rule 29). Superseded by the Packet 4B context compiler.
Modelfile.qubit4

# Operator personal knowledge (real name/contact/handles — plan rule 29).
# NEVER commit; install.sh ships a typed starter instead. Read at runtime from
# ~/.config/qubit-voicebridge/personal-knowledge.md.
config/personal-knowledge.md

# Operator task templates (real project names/paths — plan rule 29).
# NEVER commit; install.sh seeds the portable example instead.
config/task-templates.yaml

# Packet 8K release certification output (wheel/sdist + clean-HOME installs).
/dist/

# Vendored dashboard build artifacts (regenerable; see
# frontend/qubit-app/README.md). The vendored SOURCES (frontend/qubit-web,
# frontend/qubit-app) are committed; the generated bundle under
# frontend/qubit-dist is NOT — scripts/build_dashboard.sh rebuilds it, and
# pyproject force-includes it at build time so a release tree that carries it
# ships the dashboard (see scripts/hatch_build_qubit.py). Keeping it untracked
# means a fresh clone omits it, exactly as tests/test_clean_clone_wave5.py
# requires.
frontend/qubit-web/node_modules/
frontend/qubit-dist/

# Generated parity/vendor reports (regenerable; never hand-edited). Both are
# produced by their own scripts and one is ~15 MB, so committing it would add a
# large regenerable blob to history for no benefit:
#   scripts/parity_inventory.py      -> docs/generated/parity_inventory.json
#   scripts/hermes_vendor_manifest.py -> docs/generated/QUBIT_HERMES_VENDOR_MANIFEST.json
# scripts/route_e2e_audit.py CONSUMES parity_inventory.json and requires it to
# exist, so regenerate before running it (see
# docs/generated/ parity notes in AGENTS.md / the skill):
#   QUBIT_PARITY_REF_HOME=/home/trick/upstream .venv/bin/python scripts/parity_inventory.py
docs/generated/

# Runtime state artifacts that must never be committed (created under CWD by
# some tests when no state dir is injected).
session_activity.json
chat_sessions.json
chat_file_drafts.json
chat_comments.json
approvals.jsonl
power-control.json

# pytest MagicMock residue (never committed).
MagicMock/

