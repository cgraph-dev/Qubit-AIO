{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "environment": {
        "GRAFT_NO_REFRESH": "1"
      },
      "enabled": true
    }
  },
  "instructions": [
    "docs/README.md",
    "docs/STATUS.md",
    "docs/PARITY.md",
    "docs/MIGRATION.md",
    "docs/BRAND.md",
    "docs/PLAN.md",
    "docs/EXECUTION_PLAN.md",
    "docs/CHECKLIST.md",
    "docs/DECISIONS.md",
    "docs/ARCHITECTURE.md"
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 20000
  },
  "formatter": false
}
