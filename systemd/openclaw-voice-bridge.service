[Unit]
Description=OpenClaw Voice Bridge (push-to-talk voice interface)
After=network.target openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=simple
ExecStart=%h/Projects/Repos/openclaw-voice-bridge/.venv/bin/python -m voicebridge run
WorkingDirectory=%h/Projects/Repos/openclaw-voice-bridge
Restart=on-failure
RestartSec=3
# CUDA 12 libs ship inside the Ollama install; without them faster-whisper falls back to CPU
Environment=LD_LIBRARY_PATH=/usr/local/lib/ollama/cuda_v12
# Hotkey (pynput) needs the X11 session; comment the two lines below for headless/manual mode
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=VOICE_BRIDGE_CONFIG=%h/.config/openclaw-voice-bridge/voice.yaml

[Install]
WantedBy=default.target
