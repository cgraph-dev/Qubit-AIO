[Unit]
Description=OpenClaw Voice Bridge (push-to-talk voice interface)
After=network.target
# OpenClaw gateway + ollama (local LLM) should be up first if they exist as units:
After=openclaw-gateway.service ollama.service
Wants=ollama.service

[Service]
Type=simple
# __PROJECT_DIR__ is replaced with the actual path by scripts/install.sh
ExecStart=__PROJECT_DIR__/.venv/bin/python -m voicebridge run
WorkingDirectory=__PROJECT_DIR__
Restart=on-failure
RestartSec=3
# Hotkey (pynput) needs your graphical session. Set DISPLAY/XAUTHORITY to your
# session's values (check: echo $DISPLAY; echo $XAUTHORITY) or run headless
# with --no-hotkey (manual Enter PTT).
Environment=DISPLAY=:0
# Environment=XAUTHORITY=/run/user/1000/xdg/xwaylandauth.XXXX
Environment=VOICE_BRIDGE_CONFIG=%h/.config/openclaw-voice-bridge/voice.yaml
# Only needed if you use the whisper fallback ASR on CUDA with a non-standard
# CUDA install (sherpa/moonshine run on CPU by default):
# Environment=LD_LIBRARY_PATH=/usr/local/lib/ollama/cuda_v12

[Install]
WantedBy=default.target
