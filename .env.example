# Environment secrets for the PersonaPlex voice system.
# Copy to .env and fill in. NEVER commit real values.

# --- Vast.ai (renting GPUs) ------------------------------------------------
VAST_API_KEY=

# --- HuggingFace (PersonaPlex weights are gated) ---------------------------
# Accept the license first: https://huggingface.co/nvidia/personaplex-7b-v1
HF_TOKEN=

# --- Tailscale (PC ⇄ Vast transport) ----------------------------------------
# Generate an auth key in the Tailscale admin console (Settings → Keys).
TAILSCALE_AUTHKEY=

# --- OpenClaw gateway (already set in ~/.openclaw/.env on this PC) ----------
# The bridge discovers it automatically; keep it loopback/tailnet-only.
# OPENCLAW_GATEWAY_TOKEN=

# --- Voice bridge overrides (optional) ---------------------------------------
# VOICE_BRIDGE_PERSONAPLEX_ENABLED=true
# VOICE_BRIDGE_PERSONAPLEX_URL=wss://personaplex:8998/api/chat
# VOICE_BRIDGE_HERMES_ENABLED=true
