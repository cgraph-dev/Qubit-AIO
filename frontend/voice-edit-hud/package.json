{
  "name": "qubit-voice-edit-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone static Voice Edit HUD for Qubit (Next.js + TypeScript + Three.js + GSAP).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out -l 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "15.5.28",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
