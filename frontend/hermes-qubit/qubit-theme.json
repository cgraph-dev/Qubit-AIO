{
  "name": "qubit",
  "label": "Qubit Command",
  "description": "Qubit graphite/navy foundation with signal-lime and electric-cyan accents",
  "palette": {
    "background": {
      "hex": "#10141c",
      "alpha": 1
    },
    "midground": {
      "hex": "#e8f0e4",
      "alpha": 1
    },
    "foreground": {
      "hex": "#ffffff",
      "alpha": 0
    },
    "warmGlow": "rgba(163, 230, 53, 0.28)",
    "noiseOpacity": 0.6
  },
  "typography": {
    "fontSans": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "fontMono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "baseSize": "15px",
    "lineHeight": "1.55",
    "letterSpacing": "-0.005em"
  },
  "layout": {
    "radius": "0.625rem",
    "density": "comfortable"
  },
  "terminalBackground": "#0b0e13",
  "terminalForeground": "#d7e3d0",
  "colorOverrides": {
    "destructive": "#e5484d",
    "warning": "#f5a524",
    "accent": "#a3e635",
    "accentSecondary": "#22d3ee"
  },
  "swatchColors": [
    "#10141c",
    "#2a3342",
    "#a3e635"
  ],
  "customCSS": ":root{--qubit-lime:#a3e635;--qubit-cyan:#22d3ee;--qubit-graphite:#10141c}.qubit-brandmark{font-weight:700;letter-spacing:.02em}header span.text-midground.font-bold{display:none!important}div.flex.h-14.shrink-0 span.text-midground.font-bold{display:none!important}"
}
