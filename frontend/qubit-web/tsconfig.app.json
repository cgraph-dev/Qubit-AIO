{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      /*
       * The app typechecks shared TSX source directly. Resolving React from
       * both sibling node_modules creates two incompatible CSSProperties
       * (csstype) graphs. Type-only redirect: Vite still dedupes runtime React.
       */
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "@/*": ["./src/*"],
      "@qubit/shared": ["../qubit-shared/src/index.ts"],
      "@qubit/shared/*": ["../qubit-shared/src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "../qubit-shared/src"],
  "exclude": [
    "../qubit-shared/src/**/*.test.ts",
    "../qubit-shared/src/**/*.test.tsx"
  ]
}
